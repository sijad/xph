{
	"name": "xph-workspace",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sijad/xph.git"
	},
	"type": "module",
	"scripts": {
		"build:website": "node scripts/build-website.mjs",
		"preview:website": "node scripts/preview-website.mjs",
		"build": "pnpm --filter xph build && pnpm --filter xph-language-server build && pnpm --filter xph-vscode build",
		"test": "vitest run",
		"check": "tsc --noEmit && pnpm lint && pnpm format:check",
		"format": "oxfmt --write .",
		"test:package": "node scripts/package-smoke.mjs",
		"lint": "oxlint --deny-warnings packages tests scripts examples/basic vitest.config.ts",
		"format:check": "oxfmt --check .",
		"package:vscode": "pnpm build && node scripts/package-vsix.mjs",
		"release:check": "pnpm check && pnpm build && pnpm test && pnpm test:package",
		"publish:npm": "pnpm release:check && pnpm --filter xph publish --access public",
		"publish:npm:preview": "pnpm release:check && pnpm --filter xph pack --dry-run"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"entities": "^8.1.0",
		"esbuild": "^0.28.2",
		"fflate": "^0.8.3",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.1",
		"shiki": "^4.5.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"vscode-oniguruma": "^2.0.1",
		"vscode-textmate": "^9.3.2"
	}
}
