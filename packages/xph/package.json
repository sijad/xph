{
	"name": "xph",
	"version": "0.1.3",
	"description": "Typed components compiled to PHP",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sijad/xph.git",
		"directory": "packages/xph"
	},
	"bin": {
		"xph": "dist/cli.js"
	},
	"files": [
		"dist",
		"runtime"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "node ../../scripts/clean.mjs && tsc -p tsconfig.json && node ../../scripts/bundle-lsp.mjs"
	},
	"dependencies": {
		"@astrojs/compiler-rs": "^0.5.2",
		"chokidar": "^6.0.0",
		"entities": "^8.1.0",
		"esbuild": "^0.28.2",
		"postcss": "^8.5.31",
		"postcss-load-config": "^6.0.1",
		"postcss-selector-parser": "^7.1.7",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	},
	"peerDependencies": {
		"prettier": ">=3.0.0",
		"prettier-plugin-astro": ">=0.12.0"
	},
	"peerDependenciesMeta": {
		"prettier": {
			"optional": true
		},
		"prettier-plugin-astro": {
			"optional": true
		}
	}
}
