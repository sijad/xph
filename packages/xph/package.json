{
	"name": "xph",
	"version": "0.1.0",
	"description": "Typed components compiled to PHP",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sijad/xph.git",
		"directory": "packages/xph"
	},
	"bin": {
		"xph": "dist/cli.js"
	},
	"files": [
		"dist",
		"runtime",
		"neovim"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./astro": {
			"types": "./dist/astro-integration.d.ts",
			"import": "./dist/astro-integration.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json && esbuild ../language-server/src/index.ts --bundle --external:xph --external:typescript --external:prettier --external:prettier-plugin-astro --platform=node --format=esm --outfile=dist/lsp.js"
	},
	"dependencies": {
		"@astrojs/compiler-rs": "0.5.2",
		"chokidar": "5.0.0",
		"entities": "6.0.1",
		"esbuild": "0.25.12",
		"postcss": "8.5.26",
		"postcss-selector-parser": "7.1.1",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"prettier": ">=3.0.0",
		"prettier-plugin-astro": ">=0.12.0"
	},
	"peerDependenciesMeta": {
		"prettier": {
			"optional": true
		},
		"prettier-plugin-astro": {
			"optional": true
		}
	}
}
