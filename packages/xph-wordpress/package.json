{
	"name": "xph-wordpress",
	"version": "0.1.2",
	"description": "Build WordPress themes and blocks with XPH and live PHP previews",
	"homepage": "https://xph.js.org/",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sijad/xph.git",
		"directory": "packages/xph-wordpress"
	},
	"bin": {
		"xph-wordpress": "dist/cli.js"
	},
	"files": [
		"dist",
		"schemas/block.json"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./acf": {
			"types": "./dist/acf.d.ts",
			"import": "./dist/acf.js"
		}
	},
	"scripts": {
		"build": "node ../../scripts/clean.mjs && tsc -p tsconfig.json && node ../../scripts/bundle-dev.mjs"
	},
	"dependencies": {
		"acf-generator": "^0.3.0",
		"ajv": "^8.17.1",
		"chokidar": "^6.0.0",
		"esbuild": "^0.28.2"
	},
	"devDependencies": {
		"xph": "workspace:^",
		"xph-dev": "workspace:^"
	},
	"peerDependencies": {
		"xph": "workspace:^"
	}
}
