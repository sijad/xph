{
	"name": "xph-wordpress",
	"version": "0.1.0",
	"description": "Build WordPress themes and blocks with XPH and live PHP previews",
	"license": "MIT",
	"bin": {
		"xph-wordpress": "dist/cli.js"
	},
	"files": [
		"dist",
		"schemas/block.json"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"import": "./dist/vite.js"
		}
	},
	"scripts": {
		"build": "node ../../scripts/clean.mjs && tsc -p tsconfig.json"
	},
	"dependencies": {
		"ajv": "^8.17.1",
		"chokidar": "^6.0.0",
		"esbuild": "^0.28.2",
		"proxy-html-rewrite": "^0.1.0"
	},
	"devDependencies": {
		"vite": "^8.3.5",
		"xph": "workspace:^"
	},
	"peerDependencies": {
		"vite": ">=6 <9",
		"xph": "workspace:^"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	}
}
