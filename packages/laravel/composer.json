{
	"name": "sijad/xph",
	"description": "Render compiled xph components in Laravel Blade with automatic assets",
	"type": "library",
	"license": "MIT",
	"require": {
		"php": "^8.3",
		"illuminate/support": "^13.0",
		"illuminate/view": "^13.0",
		"illuminate/http": "^13.0",
		"illuminate/contracts": "^13.0"
	},
	"require-dev": {
		"orchestra/testbench": "^11.0",
		"phpunit/phpunit": "^12.0"
	},
	"autoload": {
		"psr-4": {
			"Xph\\Laravel\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Xph\\Laravel\\Tests\\": "tests/"
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"Xph\\Laravel\\XphServiceProvider"
			]
		}
	},
	"scripts": {
		"test": "phpunit"
	}
}
