---
import Card from "./Card.xph";
import Countdown from "./Countdown.xph";
import List from "./List.xph";

export interface Props {
  title: string;
  items: string[];
}

export interface Server {
  itemCount: number;
}
---

<script is:server>
  return [
    'itemCount' => count($props['items']),
  ];
</script>

<main>
  <Card title={props.title}>
    <p>
      A typed component rendered by PHP, with {server.itemCount} features to
      explore.
    </p>

    <h2>Features</h2>
    <List items={props.items}>
      {(item: string, index: number) => (
        <strong>
          {index + 1}. {item}
        </strong>
      )}
    </List>

    <h2>Recursive countdown</h2>
    <p>The Countdown component calls itself until it reaches 1.</p>
    <ul>
      <Countdown count={3} />
    </ul>
    <h2>Browser countdown</h2>
    <div data-countdown>
      <p>Seconds remaining: <output data-countdown-value>5</output></p>
      <button type="button" data-countdown-start>Start countdown</button>
    </div>
  </Card>
</main>

<script>
  import { initializeCountdowns } from "./countdown.ts";

  initializeCountdowns();
</script>
