---
import Card from "./Card.xph";
import Countdown from "./Countdown.xph";
import List from "./List.xph";

export interface Props {
  title: string;
  items: string[];
}

export interface Server {
  itemCount: number;
}
---

<script is:server>
  return [
    'itemCount' => count($props['items']),
  ];
</script>
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{props.title}</title>
  </head>
  <body>
    <main>
      <Card title={props.title}>
        <p>
          A typed component rendered by PHP, with {server.itemCount} features to
          explore.
        </p>

        <h2>Features</h2>
        <List items={props.items}>
          {(item: string, index: number) => (
            <strong>
              {index + 1}. {item}
            </strong>
          )}
        </List>

        <h2>Recursive countdown</h2>
        <p>The Countdown component calls itself until it reaches 1.</p>
        <ul>
          <Countdown count={3} />
        </ul>
      </Card>
    </main>
  </body>
</html>
<script>
  document.querySelector("h2")?.classList.add("ready");
</script>
