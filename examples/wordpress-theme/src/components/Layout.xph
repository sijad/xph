---
interface Server {
  head: string;
  footer: string;
}
---

<script is:server>
  ob_start();
  wp_head();
  $head = '<meta charset="utf-8"><meta name="viewport" content="width=device-width">' . ob_get_clean();

  ob_start();
  wp_footer();
  $footer = ob_get_clean();

  return [
    'head' => $head,
    'footer' => $footer
  ];
</script>

<!doctype html>
<html lang="en">
  <head set:html={server.head} />
  <body>
    <slot />
    <div set:html={server.footer} />
  </body>
</html>

<style>
  body {
    font-family: system-ui, sans-serif;
    margin: 3rem auto;
    max-width: 60rem;
    padding: 0 1rem;
  }
</style>
